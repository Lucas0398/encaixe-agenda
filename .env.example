# Copie para .env e preencha. NUNCA faça commit do .env (o repositório é público).

AMBIENTE=desenvolvimento
DATABASE_URL=postgresql://encaixe:encaixe@localhost:5432/encaixe

# WhatsApp Cloud API — Meta for Developers → seu app → WhatsApp → Configuração da API
WHATSAPP_TOKEN=                # token permanente do usuário do sistema (não o temporário de 24h)
WHATSAPP_PHONE_NUMBER_ID=      # "Identificação do número de telefone"
WHATSAPP_APP_SECRET=           # Configurações do app → Básico → Chave secreta do app
WHATSAPP_VERIFY_TOKEN=         # texto aleatório que você inventa e cadastra no webhook
WHATSAPP_GRAPH_VERSAO=v23.0    # confira a versão atual da Graph API na documentação da Meta

# Google Agenda — chave JSON da conta de serviço (pasta credenciais/ está no .gitignore)
GOOGLE_CREDENCIAIS_ARQUIVO=credenciais/google-service-account.json

# IA
ANTHROPIC_API_KEY=
